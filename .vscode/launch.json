{
   // Use IntelliSense to find out which attributes exist for C# debugging
   // Use hover for the description of the existing attributes
   // For further information visit https://github.com/OmniSharp/omnisharp-vscode/blob/master/debugger-launchjson.md
   "version": "0.2.0",
   "configurations": [
        {
            "name": "Run DesktopGL platform",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "buildDesktopGL",
            // If you have changed target frameworks, make sure to update the program path.
            "program": "${workspaceFolder}/Platforms/DesktopGL/bin/Debug/net10.0/UltimateTicTacToe.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Platforms/DesktopGL",
            // For more information about the 'console' field, see https://github.com/OmniSharp/omnisharp-vscode/blob/master/debugger-launchjson.md#console-terminal-window
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Run WindowsDX platform",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "buildWindowsDX",
            // If you have changed target frameworks, make sure to update the program path.
            "program": "${workspaceFolder}/Platforms/WindowsDX/bin/Debug/net10.0-windows/UltimateTicTacToe.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Platforms/WindowsDX",
            // For more information about the 'console' field, see https://github.com/OmniSharp/omnisharp-vscode/blob/master/debugger-launchjson.md#console-terminal-window
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Run DesktopGL.KNI platform",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "buildDesktopGLKNI",
            "program": "${workspaceFolder}/Platforms/DesktopGL.KNI/bin/AnyCPU/Debug/net8.0/UltimateTicTacToe.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Platforms/DesktopGL.KNI",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Run WindowsDX.KNI platform",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "buildWindowsDXKNI",
            "program": "${workspaceFolder}/Platforms/WindowsDX.KNI/bin/AnyCPU/Debug/net8.0-windows/UltimateTicTacToe.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Platforms/WindowsDX.KNI",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Run BlazorGL.KNI platform (browser)",
            "type": "blazorwasm",
            "request": "launch",
            "cwd": "${workspaceFolder}/Platforms/BlazorGL.KNI"
        }
    ]
}
