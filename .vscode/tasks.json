{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "buildDesktopGL",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Platforms/DesktopGL/DesktopGL.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "buildWindowsDX",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Platforms/WindowsDX/WindowsDX.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "buildDesktopGLKNI",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Platforms/DesktopGL.KNI/DesktopGL.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "buildWindowsDXKNI",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Platforms/WindowsDX.KNI/WindowsDX.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "buildBlazorGL",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Platforms/BlazorGL.KNI/BlazorGL.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publishDesktopGL",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/Platforms/DesktopGL/DesktopGL.csproj",
                "-c",
                "Release"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publishWindowsDX",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/Platforms/WindowsDX/WindowsDX.csproj",
                "-c",
                "Release"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publishWeb",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/Platforms/BlazorGL.KNI/BlazorGL.csproj",
                "-c",
                "Release",
                "--output",
                "${workspaceFolder}/artifacts/web"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "runWeb",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/Platforms/BlazorGL.KNI/BlazorGL.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/Platforms/DesktopGL/DesktopGL.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
