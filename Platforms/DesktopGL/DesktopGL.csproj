<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>UltimateTicTacToe</AssemblyName>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <MonoGamePlatform>DesktopGl</MonoGamePlatform>
    <PublishTrimmed>true</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <NoBeautyFlag>True</NoBeautyFlag>
    <BeautyExcludes>SDL2*;libSDL2*;sdl2*;soft_oal*;openal*;MonoGame.Framework*</BeautyExcludes>
  </PropertyGroup>

  <!-- A .app bundle hides its own contents, so there's nothing to tidy away on
       macOS. Skipping it also leaves the host and the runtime dylibs with the
       signatures they shipped with, which Apple Silicon refuses to run without. -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
    <DisableBeauty>True</DisableBeauty>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5" />
    <PackageReference Include="nulastudio.NetCoreBeauty" Version="1.2.9.3" />
    <PackageReference Include="Apos.Input" Version="3.0.0" />
    <PackageReference Include="Apos.Shapes" Version="0.8.1" />
    <PackageReference Include="Apos.Tweens" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../Game/**/*.cs">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <!-- SDL looks the window icon up as "UltimateTicTacToe.Icon.bmp", then "Icon.bmp".
       The default resource name is "DesktopGL.Icon.bmp", after the project file, which
       matches neither, so without LogicalName the window shows MonoGame's logo. -->
  <ItemGroup>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Nothing here needs building: Apos.Shapes reads the font's outlines itself, so the file
       is copied as-is and the content pipeline stays out of it. -->
  <ItemGroup>
    <Content Include="../../Content/**/*.ttf" Exclude="../../Content/bin/**;../../Content/obj/**" CopyToOutputDirectory="PreserveNewest">
      <Link>Content/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

</Project>
