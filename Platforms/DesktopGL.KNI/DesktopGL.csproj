<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <EnableDefaultItems>false</EnableDefaultItems>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <OutputType>WinExe</OutputType>
    <PublishTrimmed>True</PublishTrimmed>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>GameProject</RootNamespace>
    <AssemblyName>UltimateTicTacToe</AssemblyName>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <DefineConstants>$(DefineConstants);KNI;DESKTOPGL</DefineConstants>
    <KniPlatform>DesktopGL</KniPlatform>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="nkast.Xna.Framework" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Content" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Graphics" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Audio" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Media" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Input" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Game" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Devices" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Storage" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.XR" Version="4.2.9001" />
    <PackageReference Include="nkast.Kni.Platform.SDL2.GL" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Content.Pipeline.Builder" Version="4.2.9001" />

    <PackageReference Include="Apos.Input.KNI" Version="2.5.0" />
    <PackageReference Include="Apos.Shapes.KNI" Version="0.8.1" />
    <PackageReference Include="Apos.Tweens.KNI" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <!-- SDL looks the window icon up as "UltimateTicTacToe.Icon.bmp", then "Icon.bmp". The
       default resource name is "GameProject.Icon.bmp", after RootNamespace, which matches
       neither, so without LogicalName the window shows KNI's logo. -->
  <ItemGroup>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
    <None Include="Icon.ico" />
    <None Include="app.manifest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../Game/**/*.cs">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <!-- Nothing here needs building: Apos.Shapes reads the font's outlines itself, so the file
       is copied as-is. The KNI pipeline shells out to MGCB.exe, which doesn't exist on Linux. -->
  <ItemGroup>
    <Content Include="../../Content/**/*.ttf" Exclude="../../Content/bin/**;../../Content/obj/**" CopyToOutputDirectory="PreserveNewest">
      <Link>Content/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

</Project>
